{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role (owner or worker)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["owner", "worker"] },
        "canAddProducts": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Mattress product tracked in wholesale inventory",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "sku": { "type": "string", "maxLength": 64 },
        "brand": { "type": "string", "maxLength": 100 },
        "material": { "type": "string", "maxLength": 100 },
        "coverType": { "type": "string", "maxLength": 50 },
        "size": { "type": "string", "maxLength": 100 },
        "thickness": { "type": "string", "maxLength": 50 },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "retailPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "sku", "brand", "size", "purchasePrice", "sellingPrice", "currentStock"]
    },
    "InventoryTransaction": {
      "title": "InventoryTransaction",
      "description": "Log of stock additions, sales reductions, and returns",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["purchase", "sale", "customer_return", "supplier_return", "manual_adjustment"] },
        "quantity": { "type": "number" },
        "prevStock": { "type": "number" },
        "newStock": { "type": "number" },
        "referenceId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "type", "quantity", "prevStock", "newStock"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Wholesale mattress shopkeeper or client",
      "type": "object",
      "properties": {
        "shopName": { "type": "string", "maxLength": 150 },
        "customerName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["shopName", "customerName", "phone", "currentBalance"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Mattress brand factory or manufacturing vendor",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "maxLength": 150 },
        "contactPerson": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 300 },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["companyName", "phone", "currentBalance"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Stock purchase from factory/brand",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 150 },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "maxLength": 30 },
        "date": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["invoiceNumber", "supplierId", "totalAmount", "paidAmount", "remainingAmount"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sales invoice generated at POS for shopkeeper",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "subtotal": { "type": "number" },
        "totalDiscount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 30 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "workerName": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["invoiceNumber", "customerId", "totalAmount", "paidAmount", "remainingAmount", "createdBy"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Customer recovery payment or supplier payout",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["customer_payment", "supplier_payment"] },
        "partyId": { "type": "string", "maxLength": 128 },
        "partyName": { "type": "string", "maxLength": 150 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "referenceInvoiceNumber": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 500 },
        "receivedBy": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "partyId", "partyName", "amount", "createdBy"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expenditure with Fixed and Variable classification",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "expenseType": { "type": "string", "enum": ["fixed", "variable"] },
        "category": { "type": "string", "enum": ["rent", "utility_bills", "electricity", "salaries", "taxes", "transport", "fuel", "repairs", "tea_refreshment", "formality", "packaging", "other"] },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 30 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "expenseType", "category", "amount", "createdBy"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable activity audit log record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 500 },
        "entityType": { "type": "string", "maxLength": 50 },
        "entityId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "action", "details"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Application business settings and metadata",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "taxOrNtn": { "type": "string", "maxLength": 50 },
        "invoiceFooterNote": { "type": "string", "maxLength": 300 },
        "defaultCurrency": { "type": "string", "maxLength": 10 },
        "updatedAt": { "type": "string" }
      },
      "required": ["businessName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile with role assignment (owner or worker)"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Mattress catalog and live inventory count"
    },
    "/inventoryTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/InventoryTransaction" },
      "description": "Ledger of inventory stock movements"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Mattress wholesale shopkeepers and account balance"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Mattress manufacturers and factory vendor accounts"
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Factory purchase orders and stock receipts"
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Wholesale POS sales invoices"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Cash/Bank receipts from customers and payments to factories"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Operational overhead expenses"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "System activity logs recorded for security and accountability"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Business settings and print invoice configuration"
    }
  }
}
